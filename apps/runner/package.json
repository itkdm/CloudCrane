{
  "name": "@cloudcrane/runner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude dist/** --exclude .next/**"
  },
  "dependencies": {
    "@cloudcrane/shared": "workspace:*",
    "@cloudcrane/workspace-protocol": "workspace:*",
    "dockerode": "5.0.1",
    "pino": "10.3.1",
    "ws": "8.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.1",
    "@types/ws": "8.18.1"
  }
}
