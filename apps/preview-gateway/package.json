{
  "name": "@cloudcrane/preview-gateway",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude dist/** --exclude .next/**"
  },
  "dependencies": {
    "@cloudcrane/db": "workspace:*",
    "@cloudcrane/preview-access": "workspace:*",
    "@cloudcrane/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "zod": "4.5.4"
  }
}
