[Unit]
Description=CloudCrane %i service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudcrane
Group=cloudcrane
WorkingDirectory=/opt/cloudcrane
EnvironmentFile=/etc/cloudcrane/cloudcrane.env
ExecStart=/usr/bin/pnpm --filter @cloudcrane/%i start
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=cloudcrane-%i
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
LimitNOFILE=65536
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
