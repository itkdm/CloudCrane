# Render with envsubst '${PRODUCTION_HOST_SUFFIX} ${PRODUCTION_TLS_CERTIFICATE} ${PRODUCTION_TLS_CERTIFICATE_KEY}'
# after the suffix, wildcard DNS, and wildcard TLS certificate are configured.
# Keep production-site access logs off because application URLs can contain user data.
server {
    listen 80;
    listen [::]:80;
    server_name *.${PRODUCTION_HOST_SUFFIX};

    access_log off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name *.${PRODUCTION_HOST_SUFFIX};

    ssl_certificate ${PRODUCTION_TLS_CERTIFICATE};
    ssl_certificate_key ${PRODUCTION_TLS_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100m;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:4104;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 15s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}
