# Platform PostgreSQL 连接地址；本地开发默认连接 localhost:5432 上的 cloudcrane 数据库。
# 远程联调时通过 SSH 隧道连接远程数据库，不要把真实密码提交到仓库。
DATABASE_URL=postgresql://cloudcrane:cloudcrane@localhost:5432/cloudcrane

# Web 对外访问地址；必须与浏览器实际访问的来源一致。
WEB_ORIGIN=http://localhost:3000

# Web 连接 Agent Service 的地址；默认 Agent Service 使用 4101 端口。
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:4101

# Preview Gateway 监听端口。
PREVIEW_GATEWAY_PORT=4103

# 本地 Preview 地址模板；{websiteId} 会替换为 Website UUID。
PREVIEW_GATEWAY_ORIGIN_TEMPLATE=http://site-{websiteId}.localhost:4103/

# 生产 Preview 只能使用委托的 preview 子域名，不能指向 itkdm.com 主域名。
# PREVIEW_GATEWAY_ORIGIN_TEMPLATE=https://site-{websiteId}.preview.itkdm.com/

# 允许 Preview 请求使用的 Host 后缀；生产环境填写实际 Preview 域名后缀。
# PREVIEW_HOST_SUFFIXES=preview.itkdm.com

# Preview 对外访问协议；本地 HTTP，生产 HTTPS。
PREVIEW_PUBLIC_PROTOCOL=http

# 是否为 Preview Cookie 启用 Secure；本地 HTTP 必须为 false，生产 HTTPS 应为 true。
PREVIEW_COOKIE_SECURE=false

# Preview 签名密钥；这里只能使用本地开发占位值，生产必须从服务器私密环境注入。
PREVIEW_SIGNING_SECRET=cloudcrane-preview-dev-secret

# Preview 访问凭证有效期，单位为秒。
PREVIEW_TOKEN_TTL_SECONDS=600

# Agent Service 监听端口。
AGENT_SERVICE_PORT=4101

# Web/Agent Service 访问 Workspace Gateway 的内部地址。
WORKSPACE_GATEWAY_ENDPOINT=http://127.0.0.1:4102

# Workspace Gateway 客户端鉴权 Token；这里只是本地开发占位值，生产必须替换。
WORKSPACE_GATEWAY_CLIENT_TOKEN=dev-client-token

# Agent 会话、运行记录及本地运行数据的存储根目录；不要放入 Git。
AGENT_DATA_ROOT=.cloudcrane-data

# 官方模板不可变 ZIP 的私有存储目录；不要暴露为静态资源，也不要提交到 Git。
TEMPLATE_ARTIFACT_ROOT=.cloudcrane-data/templates

# Web 调用 Agent Service 内部模板挂载接口的地址和服务间 Token；生产必须注入同一随机值。
AGENT_SERVICE_INTERNAL_URL=http://127.0.0.1:4101
AGENT_SERVICE_INTERNAL_TOKEN=replace-with-a-random-internal-service-token

# 同时填写下面两个值后，Agent 才会启用模型调用。
# 模型凭据文件必须保存在本机或服务器私密路径，不要提交到仓库。
AGENT_MODEL_PROVIDER=
AGENT_MODEL_ID=

# 模型认证配置文件路径；路径只应指向本机/服务器上的私密文件。
AGENT_MODEL_AUTH_PATH=

# Better Auth 服务端签名密钥，至少 32 个字符；生产环境必须使用随机私密值。
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Better Auth 回调和邮件链接使用的 Web 地址。
BETTER_AUTH_URL=http://localhost:3000

# 是否要求新用户完成邮箱验证；生产环境建议保持 true。
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# 暂时关闭邮箱验证时同步给浏览器的显示配置；生产启用邮箱验证时改为 true。
NEXT_PUBLIC_AUTH_REQUIRE_EMAIL_VERIFICATION=true

# 邮件发件人和 Resend API Key；仅服务器私密环境配置，禁止提交真实值。
AUTH_EMAIL_FROM=CloudCrane <noreply@example.com>
RESEND_API_KEY=

# Google OAuth 凭据；未配置时 Google 登录按钮会返回不可用，不影响邮箱密码登录。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
