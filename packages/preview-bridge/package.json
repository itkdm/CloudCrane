{
  "name": "@cloudcrane/preview-bridge",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser.js": "./dist/browser.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude dist/** --exclude .next/**"
  },
  "dependencies": {
    "@cloudcrane/preview-protocol": "workspace:*"
  }
}
