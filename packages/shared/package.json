{
  "name": "@cloudcrane/shared",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./session-title": {
      "types": "./dist/session-title.d.ts",
      "default": "./dist/session-title.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude dist/** --exclude .next/**"
  },
  "dependencies": {
    "pino": "10.3.1"
  }
}
