    "test": "vitest run --exclude dist/** --exclude .next/**"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.218.0",
    "@opentelemetry/sdk-node": "0.218.0",
    "pino": "10.3.1"
  }
}
