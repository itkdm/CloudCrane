#!/usr/bin/env php
<?php
declare(strict_types=1);

const WORKSPACE = '/workspace';
const TARGET_VERSION = '3.2.26';
const MANAGED_BASE_MARKER = '/opt/cloudcrane/pbootcms-base/.cloudcrane-base';
const RELEASE_REGISTRY = '/opt/cloudcrane/pboot-releases.json';

function fail(string $message): never
{
    fwrite(STDERR, "ERROR {$message}\n");
    exit(1);
}

function normalizePath(string $value): string
{
    if ($value === '' || str_starts_with($value, '/') || str_contains($value, '\\') || preg_match('/^[A-Za-z]:/', $value)) {
        fail("unsafe snapshot path: {$value}");
    }
    $normalized = str_replace('\\', '/', $value);
    $parts = [];
    foreach (explode('/', $normalized) as $part) {
        if ($part === '' || $part === '.') continue;
        if ($part === '..') {
            if ($parts === []) fail("unsafe snapshot path: {$value}");
            array_pop($parts);
            continue;
        }
        $parts[] = $part;
    }
    $canonical = implode('/', $parts);
    if ($normalized !== $value || $canonical !== $normalized || $canonical === '' || str_starts_with($canonical, '../') || str_contains($canonical, '/../')) {
        fail("unsafe snapshot path: {$value}");
    }
    return $canonical;
}

function isManagedOrEphemeral(string $relative): bool
{
    return $relative === 'index.php'
        || $relative === 'admin.php'
        || $relative === 'api.php'
        || $relative === '.gitignore'
        || str_starts_with($relative, 'apps/')
        || str_starts_with($relative, 'core/')
        || $relative === 'config/database.php'
        || str_starts_with($relative, 'rewrite/')
        || str_starts_with($relative, '.git/')
        || str_starts_with($relative, '.cloudcrane/')
        || str_starts_with($relative, 'runtime/')
        || str_starts_with($relative, 'session/')
        || str_starts_with($relative, 'cache/')
        || str_starts_with($relative, 'log/')
        || str_starts_with($relative, 'data/backup/')
        || str_starts_with($relative, 'data/upgrade/');
}

function siteStateFiles(string $root): array
{
    $files = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::LEAVES_ONLY,
    );
    foreach ($iterator as $file) {
        if (!$file->isFile() || $file->isLink()) continue;
        $relative = normalizePath(ltrim(str_replace('\\', '/', substr($file->getPathname(), strlen($root))), '/'));
        if (!isManagedOrEphemeral($relative)) $files[] = $relative;
    }
    sort($files);
    return $files;
}

function ensureDirectory(string $directory): void
{
    if (is_dir($directory)) return;
    if (!mkdir($directory, 0775, true) && !is_dir($directory)) fail("cannot create directory: {$directory}");
}

function copyFileToStage(string $source, string $target): void
{
    if (!is_file($source) || is_link($source)) fail("snapshot payload file is missing or unsafe: {$source}");
    ensureDirectory(dirname($target));
    if (!copy($source, $target)) fail("cannot stage snapshot file: {$source}");
}

function moveWithParents(string $source, string $target): void
{
    ensureDirectory(dirname($target));
    if (!rename($source, $target)) fail("cannot promote snapshot file: {$source}");
}

function removeTree(string $root): void
{
    if (!is_dir($root)) return;
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST,
    );
    foreach ($iterator as $file) {
        if ($file->isDir()) @rmdir($file->getPathname()); else @unlink($file->getPathname());
    }
    @rmdir($root);
}

function writeRecoveryMarker(string $path, string $phase, string $backupRoot, string $stageRoot): void
{
    $payload = json_encode(
        ['phase' => $phase, 'backupRoot' => $backupRoot, 'stageRoot' => $stageRoot],
        JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES,
    );
    $temporary = $path . '.tmp';
    if (file_put_contents($temporary, $payload . "\n", LOCK_EX) === false || !rename($temporary, $path)) {
        fail('cannot write snapshot recovery marker');
    }
}

function recoverInterruptedSnapshot(string $markerPath): void
{
    if (!is_file($markerPath)) return;
    $marker = json_decode((string)file_get_contents($markerPath), true);
    if (!is_array($marker) || !in_array($marker['phase'] ?? null, ['backing_up', 'promoting'], true)) {
        fail('invalid snapshot recovery marker');
    }
    $backupRoot = $marker['backupRoot'] ?? null;
    $stageRoot = $marker['stageRoot'] ?? null;
    if (!is_string($backupRoot) || !is_string($stageRoot) || !str_starts_with($backupRoot, WORKSPACE . '/.cloudcrane/') || !str_starts_with($stageRoot, WORKSPACE . '/.cloudcrane/')) {
        fail('unsafe snapshot recovery marker');
    }
    if (($marker['phase'] ?? null) === 'promoting') {
        foreach (siteStateFiles(WORKSPACE) as $relative) @unlink(WORKSPACE . '/' . $relative);
    }
    if (is_dir($backupRoot)) {
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($backupRoot, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::LEAVES_ONLY);
        foreach ($iterator as $file) {
            if (!$file->isFile() || $file->isLink()) fail('unsafe snapshot recovery backup');
            $relative = normalizePath(ltrim(str_replace('\\', '/', substr($file->getPathname(), strlen($backupRoot))), '/'));
            moveWithParents($file->getPathname(), WORKSPACE . '/' . $relative);
        }
    }
    removeTree($backupRoot);
    removeTree($stageRoot);
    @unlink($markerPath);
}

if ($argc !== 2) fail('usage: cloudcrane-apply-pboot-snapshot REFERENCE_ID');
$referenceId = $argv[1];
if (!preg_match('/^ref_[0-9a-f-]+$/i', $referenceId)) fail('invalid reference id');
$referenceRoot = WORKSPACE . '/.cloudcrane/references/' . $referenceId;
$manifestPath = $referenceRoot . '/manifest.json';
$payloadRoot = $referenceRoot . '/payload';
if (!is_file($manifestPath) || !is_dir($payloadRoot)) fail('snapshot manifest or payload is missing');
$manifest = json_decode((string)file_get_contents($manifestPath), true);
if (!is_array($manifest) || ($manifest['artifactType'] ?? null) !== 'cloudcrane-pboot-site-snapshot') fail('unsupported snapshot artifact');
if (($manifest['snapshotSchemaVersion'] ?? null) !== 1 || ($manifest['dbEngine'] ?? null) !== 'sqlite') fail('unsupported snapshot schema');
$sourceVersion = $manifest['sourcePbootVersion'] ?? null;
if (!is_string($sourceVersion) || !preg_match('/^\d+\.\d+\.\d+$/', $sourceVersion)) fail('invalid source Pboot version');
$dbSchemaVersion = $manifest['dbSchemaVersion'] ?? null;
if (!is_string($dbSchemaVersion) || !preg_match('/^\d+\.\d+\.\d+$/', $dbSchemaVersion)) fail('invalid database schema version');
$sourceCoreCommit = $manifest['sourceCoreCommit'] ?? null;
if (!is_string($sourceCoreCommit) || !preg_match('/^[0-9a-f]{40}$/i', $sourceCoreCommit)) fail('invalid source Core commit');
if (!is_file(MANAGED_BASE_MARKER)) fail('managed Pboot Core marker is missing');
$managedBaseMarker = (string)file_get_contents(MANAGED_BASE_MARKER);
if (!str_contains($managedBaseMarker, 'pbootcms=' . TARGET_VERSION)) fail('managed Pboot Core version does not match the runtime');
$targetCoreCommit = null;
if (preg_match('/^sourceCommit=([0-9a-f]{40})$/mi', $managedBaseMarker, $matches)) $targetCoreCommit = strtolower($matches[1]);
if ($targetCoreCommit === null) fail('managed Pboot Core commit marker is missing');
if (!is_file(RELEASE_REGISTRY)) fail('managed Pboot release registry is missing');
$releaseRegistry = json_decode((string)file_get_contents(RELEASE_REGISTRY), true);
if (!is_array($releaseRegistry) || !is_array($releaseRegistry[$sourceVersion] ?? null) || ($releaseRegistry[$sourceVersion]['sourceCommit'] ?? null) !== $sourceCoreCommit) {
    fail('snapshot source Core release is not trusted');
}
$entries = $manifest['files']['entries'] ?? null;
if (!is_array($entries) || count($entries) !== ($manifest['files']['count'] ?? -1)) fail('invalid snapshot file manifest');
$seen = [];
foreach ($entries as $entry) {
    if (!is_array($entry) || !is_string($entry['path'] ?? null) || !is_int($entry['size'] ?? null) || !is_string($entry['sha256'] ?? null)) fail('invalid snapshot file entry');
    $relative = normalizePath($entry['path']);
    if (isset($seen[$relative]) || isManagedOrEphemeral($relative)) fail("snapshot contains non-site-state path: {$relative}");
    $source = $payloadRoot . '/' . $relative;
    if (!is_file($source) || is_link($source)) fail("snapshot payload file is missing or unsafe: {$relative}");
    $size = filesize($source);
    $hash = hash_file('sha256', $source);
    if ($size !== $entry['size'] || !hash_equals($entry['sha256'], (string)$hash)) fail("snapshot payload integrity check failed: {$relative}");
    $seen[$relative] = true;
}
$database = 'data/pbootcms.db';
if (!isset($seen[$database])) fail('snapshot must contain data/pbootcms.db');

$cloudcraneRoot = WORKSPACE . '/.cloudcrane';
$recoveryMarker = $cloudcraneRoot . '/.snapshot-recovery.json';
recoverInterruptedSnapshot($recoveryMarker);
$operationId = bin2hex(random_bytes(12));
$stageRoot = $cloudcraneRoot . '/.snapshot-stage-' . $operationId;
$backupRoot = $cloudcraneRoot . '/.snapshot-backup-' . $operationId;
$promoted = [];
$backedUp = [];
try {
    ensureDirectory($stageRoot);
    foreach (array_keys($seen) as $relative) {
        copyFileToStage($payloadRoot . '/' . $relative, $stageRoot . '/' . $relative);
    }
    $stagedDb = $stageRoot . '/' . $database;
    $migratedDb = $stagedDb . '.migrated';
    $command = 'cloudcrane-migrate-pboot-sqlite ' . escapeshellarg($stagedDb) . ' ' . escapeshellarg($migratedDb) . ' ' . escapeshellarg($dbSchemaVersion);
    exec($command, $output, $exitCode);
    if ($exitCode !== 0 || !is_file($migratedDb)) fail('Pboot database migration failed');
    unlink($stagedDb);
    rename($migratedDb, $stagedDb);
    exec('cloudcrane-rebind-pboot-state ' . escapeshellarg($stagedDb) . ' ' . escapeshellarg(WORKSPACE . '/' . $database), $rebindOutput, $rebindExitCode);
    if ($rebindExitCode !== 0) fail('managed Pboot state rebind failed');
    $db = new PDO('sqlite:' . $stagedDb, null, null, [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
    if ((string)$db->query('PRAGMA integrity_check')->fetchColumn() !== 'ok') fail('migrated database integrity check failed');
    $db = null;

    writeRecoveryMarker($recoveryMarker, 'backing_up', $backupRoot, $stageRoot);
    foreach (siteStateFiles(WORKSPACE) as $relative) {
        $source = WORKSPACE . '/' . $relative;
        $backup = $backupRoot . '/' . $relative;
        ensureDirectory(dirname($backup));
        moveWithParents($source, $backup);
        $backedUp[] = $relative;
    }
    writeRecoveryMarker($recoveryMarker, 'promoting', $backupRoot, $stageRoot);
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($stageRoot, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::LEAVES_ONLY,
    );
    foreach ($iterator as $file) {
        if (!$file->isFile() || $file->isLink()) fail('staged snapshot contains an unsafe file');
        $relative = normalizePath(ltrim(str_replace('\\', '/', substr($file->getPathname(), strlen($stageRoot))), '/'));
        moveWithParents($file->getPathname(), WORKSPACE . '/' . $relative);
        $promoted[] = $relative;
    }
    $db = new PDO('sqlite:' . WORKSPACE . '/' . $database, null, null, [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
    if ((string)$db->query('PRAGMA integrity_check')->fetchColumn() !== 'ok') fail('promoted database integrity check failed');
    $db = null;
    $gitPaths = array_values(array_unique(array_merge($backedUp, $promoted)));
    if ($gitPaths === []) fail('snapshot did not change site state');
    $gitAdd = 'git -C ' . escapeshellarg(WORKSPACE) . ' add -- ' . implode(' ', array_map('escapeshellarg', $gitPaths));
    exec($gitAdd, $gitOutput, $gitExitCode);
    if ($gitExitCode !== 0) fail('cannot stage restored site state');
    exec('git -C ' . escapeshellarg(WORKSPACE) . ' commit -m ' . escapeshellarg('chore: restore Pboot site snapshot'), $gitOutput, $gitExitCode);
    if ($gitExitCode !== 0 && $gitExitCode !== 1) fail('cannot commit restored site state');
    exec('git -C ' . escapeshellarg(WORKSPACE) . ' ls-files | grep -q "^\\.cloudcrane/references/"', $gitOutput, $gitExitCode);
    if ($gitExitCode === 0) fail('snapshot reference entered Website Git index');
    removeTree($backupRoot);
    removeTree($stageRoot);
    @unlink($recoveryMarker);
    echo "APPLIED {$referenceId} -> " . TARGET_VERSION . "\n";
} catch (Throwable $error) {
    foreach (array_reverse($promoted) as $relative) @unlink(WORKSPACE . '/' . $relative);
    foreach (array_reverse($backedUp) as $relative) {
        $backup = $backupRoot . '/' . $relative;
        if (is_file($backup)) moveWithParents($backup, WORKSPACE . '/' . $relative);
    }
    removeTree($stageRoot);
    removeTree($backupRoot);
    @unlink($recoveryMarker);
    fail($error->getMessage());
}
