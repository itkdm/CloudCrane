#!/bin/sh
set -eu

workspace=/workspace
base=/opt/cloudcrane/pbootcms-base
marker="$workspace/.cloudcrane/bootstrap.json"

install_builtin_skills() {
  mkdir -p "$workspace/.agents/skills"
  for skill in pboot-template-migration pbootcms-upgrade; do
    if [ -d "/opt/cloudcrane/skills/$skill" ] && [ ! -e "$workspace/.agents/skills/$skill" ]; then
      cp -a "/opt/cloudcrane/skills/$skill" "$workspace/.agents/skills/"
    fi
  done
}

if [ -f "$marker" ]; then
  test -f "$workspace/index.php"
  test -f "$workspace/data/pbootcms.db"
  test -d "$workspace/.git"
  install_builtin_skills
  printf '%s\n' 'ALREADY_INITIALIZED'
  exit 0
fi

if [ -e "$workspace/.cloudcrane" ]; then
  test -d "$workspace/.cloudcrane"
  if find "$workspace" -mindepth 1 -maxdepth 1 ! -name .cloudcrane -print -quit | grep -q .; then
    echo 'workspace contains unexpected pre-existing content' >&2
    exit 20
  fi
  if find "$workspace/.cloudcrane" -mindepth 1 -maxdepth 1 ! -name references -print -quit | grep -q .; then
    echo 'workspace contains unexpected CloudCrane content' >&2
    exit 20
  fi
  if [ -e "$workspace/.cloudcrane/references" ]; then
    test -d "$workspace/.cloudcrane/references"
  fi
elif find "$workspace" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
  echo 'workspace is non-empty and has no CloudCrane initialization marker' >&2
  exit 20
fi

cp -a "$base"/. "$workspace"/
rm -f "$workspace/.cloudcrane-base"
mkdir -p "$workspace/.cloudcrane"
install_builtin_skills
cat > "$workspace/AGENTS.md" <<'EOF'
# PbootCMS Website

- 工作根目录是 `/workspace`，当前项目是 PbootCMS Website。
- 优先修改 template、static、config 等业务区域；不要无理由修改 PbootCMS Core。
   - UI 修改完成后必须通过 Preview 验证。
   - 不绕过 PbootCMS 官方授权机制。
   - PbootCMS authorization must only be configured through official authorization codes.
   - Never modify or bypass PbootCMS authorization code or authorization verification.
   - If authorization is missing, use the CloudCrane authorization flow.
- SQLite 是网站数据，不作为普通 Git Code Change 处理。
- If `/workspace/.cloudcrane/references/<referenceId>` exists, it is a READ-ONLY reference snapshot. Analyze it with read, ls, find, rg, cat, and read-only SQLite inspection; never write, delete, execute, or deploy it. `/workspace` remains the only writable target.
- Treat the reference as a source to understand and rebuild the site in the managed PbootCMS runtime; never copy its core, apps, authorization, administrator, runtime, or system state wholesale.
EOF

if [ -f "$workspace/.gitignore" ]; then
  grep -qxF 'data/*.db' "$workspace/.gitignore" || printf '%s\n' 'data/*.db' >> "$workspace/.gitignore"
  grep -qxF 'runtime/' "$workspace/.gitignore" || printf '%s\n' 'runtime/' >> "$workspace/.gitignore"
  grep -qxF '.cloudcrane/references/' "$workspace/.gitignore" || printf '%s\n' '.cloudcrane/references/' >> "$workspace/.gitignore"
else
  printf '%s\n' 'data/*.db' 'runtime/' '.cloudcrane/references/' > "$workspace/.gitignore"
fi

git -C "$workspace" init -b main >/dev/null
git -C "$workspace" config user.name 'CloudCrane Agent'
git -C "$workspace" config user.email 'agent@cloudcrane.local'

test -f "$workspace/index.php"
test -f "$workspace/admin.php"
test -d "$workspace/apps"
test -d "$workspace/core"
test -d "$workspace/config"
test -f "$workspace/data/pbootcms.db"
test -d "$workspace/template"
test -d "$workspace/static"
sqlite3 "$workspace/data/pbootcms.db" 'PRAGMA integrity_check;' | grep -qxF ok
php -r '$db = new PDO("sqlite:/workspace/data/pbootcms.db"); if ($db->query("PRAGMA integrity_check")->fetchColumn() !== "ok") { exit(1); }'

cat > "$marker" <<EOF
{
  "cms": "pbootcms",
  "version": "3.2.26",
  "sourceCommit": "8c7ad1da5e1d1ba217fde56912f001e14cb9b0ea",
  "initializedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

git -C "$workspace" add -A
git -C "$workspace" commit -m 'chore: initialize PbootCMS website' >/dev/null
test -z "$(git -C "$workspace" status --porcelain)"
if git -C "$workspace" ls-files | grep -q '^\.cloudcrane/references/'; then
  echo 'reference content entered Website Git index' >&2
  exit 21
fi
printf '%s\n' 'INITIALIZED'
